#openrouteservice API-Key (kostenlos unter https://openrouteservice.org/dev/dashboard/):
EXPO_PUBLIC_ORS_KEY=your-ors-api-key

#Supabase (kostenlos unter https://supabase.com -> New project):
#Project Settings -> API -> Project URL und anon public key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry Project Settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000
