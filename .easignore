# Diese Datei wird von EAS Build verwendet (falls vorhanden) statt .gitignore.
# Wichtig: .env darf hier NICHT ausgeschlossen werden, damit Builds die
# EXPO_PUBLIC_*-Variablen (openrouteservice, Google Maps) erhalten.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
